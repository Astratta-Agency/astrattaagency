# Lead capture endpoint — Supabase Edge Function that saves leads and emails info@astrattaagency.com (via Resend)
VITE_FORM_ENDPOINT=https://vdnblnrwkkychxzbixam.supabase.co/functions/v1/capture-lead

# Newsletter capture endpoint — Supabase Edge Function that saves subscribers and sends the welcome email (via Resend).
# The unsubscribe endpoint is derived from it (…/unsubscribe-newsletter).
#
# Edge Function secrets (set in Supabase → Edge Functions → Secrets, NOT here):
#   RESEND_API_KEY  — required for any email to go out
#   RESEND_FROM     — optional, default "Astratta Agency <info@astrattaagency.com>"
#   LEAD_NOTIFY_TO  — optional, default info@astrattaagency.com
#   SITE_URL        — optional, default https://astrattaagency.com
VITE_NEWSLETTER_ENDPOINT=https://vdnblnrwkkychxzbixam.supabase.co/functions/v1/subscribe-newsletter

# reCAPTCHA v3 site key (public) — from https://www.google.com/recaptcha/admin/create
VITE_RECAPTCHA_SITE_KEY=
